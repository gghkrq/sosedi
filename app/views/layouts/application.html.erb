<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Roomatch" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
  </head>

  <body>
    <nav>
      <%= link_to "Главная", root_path %> |
      <%= link_to "Статьи", articles_path %> |
      <%= link_to "Объявления", listings_path %> |
      <%= link_to "Мои объявления", my_listings_path %> |
      <%= link_to "Избранное", favorites_path %> |
      <%= link_to "Профиль", profile_path %>
      <% if current_user&.admin? %>
        | <%= link_to "Админка", admin_root_path %>
      <% end %>

      <% if logged_in? %>
        — вы: <strong><%= current_user.name %></strong>
      <% else %>
        — <%= link_to "Войти", login_path %> | <%= link_to "Регистрация", signup_path %>
      <% end %>
    </nav>
    <hr>

    <% if notice.present? %>
      <p style="color: green"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p style="color: red"><%= alert %></p>
    <% end %>

    <%= yield %>
  </body>
</html>
