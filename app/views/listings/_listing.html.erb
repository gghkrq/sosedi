<% match = compatibility_for(listing) %>
<div id="<%= dom_id listing %>">
  <h3><%= link_to listing.title, listing %></h3>
  <ul>
    <li>Город: <%= listing.city %></li>
    <li>Стоимость: <%= rub(listing.rent) %> в месяц</li>
    <li>Живут: <%= residents_text(listing) %></li>
    <% if listing.tags.any? %>
      <li>Теги: <%= listing.tag_names %></li>
    <% end %>
    <% if match %>
      <li>Совместимость: <%= match.percent %>%</li>
    <% end %>
  </ul>
</div>
<hr>
