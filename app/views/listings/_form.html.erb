<%= form_with(model: listing) do |form| %>
  <%= render "shared/errors", object: listing %>

  <div>
    <%= form.label :title, "Название", style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description, "Описание", style: "display: block" %>
    <%= form.textarea :description, rows: 5 %>
  </div>

  <div>
    <%= form.label :city, "Город", style: "display: block" %>
    <%= form.text_field :city %>
  </div>

  <div>
    <%= form.label :rent, "Стоимость в месяц, ₽", style: "display: block" %>
    <%= form.number_field :rent %>
  </div>

  <div>
    <%= form.label :rooms, "Количество комнат", style: "display: block" %>
    <%= form.number_field :rooms %>
  </div>

  <div>
    <%= form.label :max_people, "Максимум человек", style: "display: block" %>
    <%= form.number_field :max_people %>
  </div>

  <div>
    <%= form.label :status, "Статус", style: "display: block" %>
    <%= form.select :status, Listing::STATUSES.map { |s| [ status_label(s), s ] } %>
  </div>

  <fieldset>
    <legend>Срок активности</legend>
    <div>
      <%= form.radio_button :duration, "unlimited" %>
      <%= form.label :duration_unlimited, "Бессрочно" %>
    </div>
    <div>
      <%= form.radio_button :duration, "until_date" %>
      <%= form.label :duration_until_date, "До даты:" %>
      <%= form.date_field :active_until, min: Date.current %>
    </div>
  </fieldset>

  <div>
    <%= form.label :tag_names, "Теги через запятую", style: "display: block" %>
    <%= form.text_field :tag_names %>
  </div>

  <div>
    <%= form.submit "Сохранить" %>
  </div>
<% end %>
