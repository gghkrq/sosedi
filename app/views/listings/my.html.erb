<% content_for :title, "Мои объявления" %>

<h1>Мои объявления</h1>

<p><%= link_to "Разместить объявление", new_listing_path %></p>

<% @listings.each do |listing| %>
  <div>
    <h3><%= link_to listing.title, listing %></h3>
    <p>
      <%= listing.city %>, <%= rub(listing.rent) %><br>
      Статус: <%= listing_status_text(listing) %>, активно: <%= active_period(listing) %><br>
      Живут: <%= residents_text(listing) %><br>
      Откликов: <%= listing.applications.size %>
    </p>
    <p><%= link_to "Редактировать", edit_listing_path(listing) %></p>
  </div>
  <hr>
<% end %>

<% if @listings.empty? %>
  <p>У вас пока нет объявлений.</p>
<% end %>
