<% content_for :title, "Объявления" %>

<h1>Объявления</h1>

<p><%= link_to "Разместить объявление", new_listing_path %></p>

<p>
  Теги:
  <%= link_to "Все теги", listings_path %>
  <% @tags.each do |name| %>
    | <%= link_to name, listings_path(tag: name) %>
  <% end %>
  <% if params[:tag].present? %>(выбран: <strong><%= params[:tag] %></strong>)<% end %>
</p>

<hr>

<% if @listings.any? %>
  <%= render partial: "listing", collection: @listings %>
<% else %>
  <p>С этим тегом объявлений нет. <%= link_to "Показать все", listings_path %></p>
<% end %>
