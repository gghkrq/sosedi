<%= form_with(model: [ @listing, application ], class: "form") do |form| %>
  <%= render "shared/errors", object: application %>

  <div class="field">
    <%= form.label :message, "Сообщение автору" %>
    <%= form.textarea :message, rows: 6, placeholder: "Расскажите о себе и когда готовы переехать" %>
  </div>

  <div class="actions">
    <%= form.submit "Отправить отклик", class: "btn" %>
    <%= link_to "Отмена", listing_path(@listing) %>
  </div>
<% end %>
