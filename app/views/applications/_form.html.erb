<%= form_with(model: [ @listing, application ]) do |form| %>
  <%= render "shared/errors", object: application %>

  <div>
    <%= form.label :message, "Сообщение автору", style: "display: block" %>
    <%= form.textarea :message, rows: 5 %>
  </div>

  <div>
    <%= form.submit "Отправить отклик" %>
  </div>
<% end %>
